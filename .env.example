# Copy to .env and fill in as needed. Everything here is OPTIONAL — InsightRAG runs 100% free and
# offline by default (in-process embeddings + a deterministic mock LLM + in-memory vector store).

# Set an Anthropic API key to switch from the mock LLM to real Claude (provider=auto picks it up).
ANTHROPIC_API_KEY=

# --- Optional LLM overrides (defaults shown) ---
# INSIGHTRAG_LLM_PROVIDER=auto          # auto | anthropic | mock
# INSIGHTRAG_LLM_MODEL=claude-haiku-4-5

# --- Optional retrieval tuning (defaults shown) ---
# INSIGHTRAG_RETRIEVAL_TOPK=4
# INSIGHTRAG_RETRIEVAL_MIN_SCORE=0.5

# --- pgvector (only needed when running the 'pgvector' profile / docker-compose) ---
# PGVECTOR_HOST=localhost
# PGVECTOR_PORT=5432
# PGVECTOR_DB=insightrag
# PGVECTOR_USER=insightrag
# PGVECTOR_PASSWORD=insightrag
